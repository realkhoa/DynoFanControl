<Window x:Class="FanCtl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FanCtl"
        Title="FanCtl — Acer Nitro 5"
        Height="430" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#f5f5f5"
        Foreground="#222"
        FontFamily="Segoe UI, sans-serif"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:BoolToAutoManualConverter x:Key="AutoManual"/>

        <Style TargetType="Button" x:Key="AutoBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="10"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                BorderBrush="#ddd" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FanCtl" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Text="Acer Nitro AN515-45" FontSize="11" Foreground="#888"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Temps -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                BorderBrush="#ddd" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Temps}" Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#f0f4ff" CornerRadius="6" Padding="12,8" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="#d32f2f"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="1" Text="{Binding SensorCountText}" FontSize="10"
                           Foreground="#aaa" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Fan 1 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                BorderBrush="#ddd" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding Fan0Speed, StringFormat='{}{0}%'}"
                               FontSize="24" FontWeight="SemiBold" Foreground="#333"/>
                </StackPanel>
                <Slider Grid.Column="1" Margin="10,0" x:Name="Slider0"
                        Value="{Binding Fan0Speed, Mode=TwoWay}"
                        IsEnabled="{Binding Fan0Auto, Converter={StaticResource InverseBool}}"
                        PreviewMouseLeftButtonDown="Slider0_Down"
                        PreviewMouseLeftButtonUp="Slider0_Up"/>
                <Button Grid.Column="2" Content="{Binding Fan0Auto, Converter={StaticResource AutoManual}}"
                        Style="{StaticResource AutoBtn}" Click="Toggle0_Click"
                        Background="#e8e8e8" Foreground="#333"/>
            </Grid>
        </Border>

        <!-- Fan 2 -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                BorderBrush="#ddd" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GPU" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding Fan1Speed, StringFormat='{}{0}%'}"
                               FontSize="24" FontWeight="SemiBold" Foreground="#333"/>
                </StackPanel>
                <Slider Grid.Column="1" Margin="10,0" x:Name="Slider1"
                        Value="{Binding Fan1Speed, Mode=TwoWay}"
                        IsEnabled="{Binding Fan1Auto, Converter={StaticResource InverseBool}}"
                        PreviewMouseLeftButtonDown="Slider1_Down"
                        PreviewMouseLeftButtonUp="Slider1_Up"/>
                <Button Grid.Column="2" Content="{Binding Fan1Auto, Converter={StaticResource AutoManual}}"
                        Style="{StaticResource AutoBtn}" Click="Toggle1_Click"
                        Background="#e8e8e8" Foreground="#333"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="#eee" CornerRadius="6" Padding="12,6"
                VerticalAlignment="Bottom" Height="34" BorderBrush="#ddd" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="TURBO" Click="Turbo_Click"
                        Height="24" Width="60" Cursor="Hand"
                        Background="#d32f2f" Foreground="White" BorderThickness="0"
                        FontSize="10" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                           Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Grid.Column="2" Text="v1.3" FontSize="10" Foreground="#bbb" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
