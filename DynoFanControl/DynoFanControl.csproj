<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DynoFanControl</AssemblyName>
    <RootNamespace>DynoFanControl</RootNamespace>
    <Product>DynoFanControl</Product>
    <AssemblyTitle>DynoFanControl</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="app.ico" Condition="Exists('app.ico')" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ec-probe.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ec-probe.exe')" />
    <Content Include="WinRing0x64.sys" CopyToOutputDirectory="PreserveNewest" Condition="Exists('WinRing0x64.sys')" />
    <Content Include="Plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
