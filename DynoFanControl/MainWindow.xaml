<Window x:Class="DynoFanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynoFanControl"
        xmlns:vm="clr-namespace:DynoFanControl.ViewModels"
        Title="DynoFanControl — Acer Nitro 5"
        Height="630" Width="600"
        MinHeight="590" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="#121316"
        Foreground="#ECEFF1"
        FontFamily="Segoe UI, sans-serif"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToAutoManualConverter x:Key="AutoManual"/>
        <local:TempToBrushConverter x:Key="TempBrush"/>
        <local:StringEqualsConverter x:Key="StrEquals"/>

        <!-- Modern Button Styles -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#323642"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F333E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2228"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#1E2026"/>
            <Setter Property="BorderBrush" Value="#2D3039"/>
        </Style>

        <Style x:Key="TurboBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F44336"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF8A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="10"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
        </Style>

        <!-- Context Menu for Tray -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Show DynoFanControl" FontWeight="Bold" Click="TrayShow_Click"/>
            <Separator/>
            <MenuItem Header="● Auto Mode (BIOS)" Click="TrayMode_Click" Tag="Auto" IsChecked="{Binding IsAutoActive, Mode=OneWay}" IsCheckable="True"/>
            <MenuItem Header="● Silent Mode (30%)" Click="TrayMode_Click" Tag="Silent" IsChecked="{Binding IsSilentActive, Mode=OneWay}" IsCheckable="True"/>
            <MenuItem Header="● Balanced Mode (60%)" Click="TrayMode_Click" Tag="Balanced" IsChecked="{Binding IsBalancedActive, Mode=OneWay}" IsCheckable="True"/>
            <MenuItem Header="● Smart Curve" Click="TrayMode_Click" Tag="Curve" IsChecked="{Binding IsCurveActive, Mode=OneWay}" IsCheckable="True"/>
            <MenuItem Header="🔥 Max Turbo (100%)" Click="TrayMode_Click" Tag="Turbo" IsChecked="{Binding IsTurboActive, Mode=OneWay}" IsCheckable="True"/>
            <Separator/>
            <MenuItem Header="❄ CoolBoost" IsCheckable="True" IsChecked="{Binding CoolBoost, Mode=TwoWay}"/>
            <Separator/>
            <MenuItem Header="Exit DynoFanControl" Click="TrayExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="16,14,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Telemetry / Temp Cards -->
                <RowDefinition Height="Auto"/> <!-- Global Presets & Turbo -->
                <RowDefinition Height="*"/>    <!-- Fan Controls (CPU & GPU) -->
                <RowDefinition Height="Auto"/> <!-- Curve / Settings Expander -->
                <RowDefinition Height="Auto"/> <!-- Footer / Status -->
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Border Grid.Row="0" Background="#181A20" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                    BorderBrush="#262933" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E53935" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DynoFanControl" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#2B2E38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="UNIVERSAL" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                </Border>
                                <Border Background="#1A2D3C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActivePresetBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PlatformSummaryText, Mode=OneWay}" FontSize="11" Foreground="#78909C" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BaseBtn}" Height="30" Padding="8,0" Margin="3,0"
                                Click="TuningToggle_Click" ToolTip="GPU Clock, Voltage &amp; Power Tuning (Afterburner Suite)">
                            <TextBlock Text="⚡ OC" FontSize="11" FontWeight="SemiBold" Foreground="#FFD600"/>
                        </Button>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Padding="8,0" Margin="3,0"
                                Click="MonitorToggle_Click" ToolTip="Hardware Monitoring Telemetry &amp; Graphs">
                            <TextBlock Text="📉 Graphs" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Padding="8,0" Margin="3,0"
                                Click="OsdToggle_Click" ToolTip="RivaTuner Statistics Server (RTSS) In-Game OSD">
                            <TextBlock Text="📺 OSD" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Padding="8,0" Margin="3,0"
                                Click="SensorsToggle_Click" ToolTip="View All Hardware Temperature Sensors">
                            <TextBlock Text="📊 Sensors" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Padding="8,0" Margin="3,0"
                                Click="CurveToggle_Click" ToolTip="Custom Fan Curve Editor">
                            <TextBlock Text="📈 Curves" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Width="32" Margin="3,0"
                                Click="SettingsToggle_Click" ToolTip="Application Settings">
                            <TextBlock Text="⚙" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Telemetry / Temperature Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Sensor Card -->
                <Border Grid.Column="0" Background="#181A20" CornerRadius="8" Padding="12,10" Margin="0,0,5,0"
                        BorderBrush="#262933" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU TEMPERATURE" FontSize="10" FontWeight="SemiBold" Foreground="#78909C"/>
                            <TextBlock Text="{Binding CpuTempText}" FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding CpuTemp, Converter={StaticResource TempBrush}}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CpuModelName, Mode=OneWay}" FontSize="10" Foreground="#546E7A" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TACHOMETER" FontSize="9" Foreground="#78909C" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CpuFanRpmText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#CFD8DC" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU Sensor Card -->
                <Border Grid.Column="1" Background="#181A20" CornerRadius="8" Padding="12,10" Margin="5,0,0,0"
                        BorderBrush="#262933" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GPU TEMPERATURE" FontSize="10" FontWeight="SemiBold" Foreground="#78909C"/>
                            <TextBlock Text="{Binding GpuTempText}" FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding GpuName}" FontSize="10" Foreground="#90A4AE" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GpuDetailsText}" FontSize="10" Foreground="#546E7A" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TACHOMETER" FontSize="9" Foreground="#78909C" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding GpuFanRpmText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#CFD8DC" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Mode Presets & Turbo -->
            <Border Grid.Row="2" Background="#181A20" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                    BorderBrush="#262933" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Presets -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModeBtn}" Content="AUTO" Click="Mode_Click" Tag="Auto"
                                Background="{Binding AutoBtnBackground}" BorderBrush="{Binding AutoBtnBorder}"
                                Foreground="{Binding AutoBtnForeground}" FontWeight="{Binding AutoBtnFontWeight}"/>
                        <Button Style="{StaticResource ModeBtn}" Content="SILENT" Click="Mode_Click" Tag="Silent"
                                Background="{Binding SilentBtnBackground}" BorderBrush="{Binding SilentBtnBorder}"
                                Foreground="{Binding SilentBtnForeground}" FontWeight="{Binding SilentBtnFontWeight}"/>
                        <Button Style="{StaticResource ModeBtn}" Content="BALANCED" Click="Mode_Click" Tag="Balanced"
                                Background="{Binding BalancedBtnBackground}" BorderBrush="{Binding BalancedBtnBorder}"
                                Foreground="{Binding BalancedBtnForeground}" FontWeight="{Binding BalancedBtnFontWeight}"/>
                        <Button Style="{StaticResource ModeBtn}" Content="CURVE" Click="Mode_Click" Tag="Curve"
                                Background="{Binding CurveBtnBackground}" BorderBrush="{Binding CurveBtnBorder}"
                                Foreground="{Binding CurveBtnForeground}" FontWeight="{Binding CurveBtnFontWeight}"/>
                    </StackPanel>

                    <!-- Right Options & Turbo -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Link Fans Toggle -->
                        <CheckBox Content="Link Fans" IsChecked="{Binding LinkFans, Mode=TwoWay}"
                                  Foreground="#B0BEC5" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- CoolBoost Toggle -->
                        <CheckBox Content="CoolBoost" IsChecked="{Binding CoolBoost, Mode=TwoWay}"
                                  Foreground="#B0BEC5" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Turbo Button -->
                        <Button Style="{StaticResource TurboBtn}" Width="78" Height="30"
                                Content="🔥 TURBO" Click="Turbo_Click"
                                Background="{Binding TurboBtnBackground}" BorderBrush="{Binding TurboBtnBorder}"
                                Foreground="{Binding TurboBtnForeground}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Fan Controls (CPU & GPU) -->
            <StackPanel Grid.Row="3">
                <!-- CPU Fan Card -->
                <Border Background="#181A20" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#262933" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CPU FAN" FontSize="12" FontWeight="Bold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding CpuFanSpeed, StringFormat='— {0}%'}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#E53935" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding CpuFanRpmText, StringFormat='({0})'}" FontSize="11"
                                           Foreground="#78909C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Auto/Manual Toggle -->
                            <Button Grid.Column="2" Content="{Binding CpuFanAuto, Converter={StaticResource AutoManual}}"
                                    Style="{StaticResource BaseBtn}" Height="24" Padding="10,0" FontSize="10" FontWeight="Bold"
                                    Click="CpuAutoToggle_Click"/>
                        </Grid>

                        <!-- Slider -->
                        <Slider x:Name="CpuSlider" Value="{Binding CpuFanSpeed, Mode=TwoWay}"
                                IsEnabled="{Binding CpuFanAuto, Converter={StaticResource InverseBool}}"
                                PreviewMouseLeftButtonDown="CpuSlider_Down"
                                PreviewMouseLeftButtonUp="CpuSlider_Up"
                                Margin="0,4"/>

                        <!-- Quick Preset Chips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="Quick:" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource ChipBtn}" Content="30%" Click="CpuChip_Click" Tag="30"/>
                            <Button Style="{StaticResource ChipBtn}" Content="50%" Click="CpuChip_Click" Tag="50"/>
                            <Button Style="{StaticResource ChipBtn}" Content="75%" Click="CpuChip_Click" Tag="75"/>
                            <Button Style="{StaticResource ChipBtn}" Content="100%" Click="CpuChip_Click" Tag="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU Fan Card -->
                <Border Background="#181A20" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#262933" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GPU FAN" FontSize="12" FontWeight="Bold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding GpuFanSpeed, StringFormat='— {0}%'}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#00E5FF" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding GpuFanRpmText, StringFormat='({0})'}" FontSize="11"
                                           Foreground="#78909C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Auto/Manual Toggle -->
                            <Button Grid.Column="2" Content="{Binding GpuFanAuto, Converter={StaticResource AutoManual}}"
                                    Style="{StaticResource BaseBtn}" Height="24" Padding="10,0" FontSize="10" FontWeight="Bold"
                                    Click="GpuAutoToggle_Click"/>
                        </Grid>

                        <!-- Slider -->
                        <Slider x:Name="GpuSlider" Value="{Binding GpuFanSpeed, Mode=TwoWay}"
                                IsEnabled="{Binding GpuFanAuto, Converter={StaticResource InverseBool}}"
                                PreviewMouseLeftButtonDown="GpuSlider_Down"
                                PreviewMouseLeftButtonUp="GpuSlider_Up"
                                Margin="0,4"/>

                        <!-- Quick Preset Chips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="Quick:" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource ChipBtn}" Content="30%" Click="GpuChip_Click" Tag="30"/>
                            <Button Style="{StaticResource ChipBtn}" Content="50%" Click="GpuChip_Click" Tag="50"/>
                            <Button Style="{StaticResource ChipBtn}" Content="75%" Click="GpuChip_Click" Tag="75"/>
                            <Button Style="{StaticResource ChipBtn}" Content="100%" Click="GpuChip_Click" Tag="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. Curve Panel (Collapsible) -->
            <Border Grid.Row="4" Background="#181A20" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                    BorderBrush="#303440" BorderThickness="1"
                    Visibility="{Binding IsCurveEditorOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Header with Title and Sync Checkbox -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SMART FAN CURVES" FontSize="11" FontWeight="Bold" Foreground="#90A4AE" VerticalAlignment="Center"/>
                            <CheckBox Content="Sync CPU &amp; GPU Curves" IsChecked="{Binding SyncFanCurves, Mode=TwoWay}"
                                      Foreground="#78909C" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="22" Height="22" Padding="0" Click="CurveToggle_Click"/>
                    </Grid>

                    <!-- Curve Tabs: CPU Curve vs GPU Curve -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Curve Tab Button -->
                        <Button Grid.Column="0" Margin="0,0,4,0" Height="32" Click="CurveTab_Click" Tag="0"
                                Background="{Binding CpuTabBackground}" BorderBrush="{Binding CpuTabBorder}" BorderThickness="1"
                                Style="{StaticResource BaseBtn}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💻 CPU Fan Curve" FontSize="11" FontWeight="Bold" Foreground="{Binding CpuTabForeground}"/>
                                <TextBlock Text="{Binding CpuCurveLiveText, StringFormat=' ({0})'}" FontSize="10" Foreground="#78909C" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- GPU Curve Tab Button -->
                        <Button Grid.Column="1" Margin="4,0,0,0" Height="32" Click="CurveTab_Click" Tag="1"
                                Background="{Binding GpuTabBackground}" BorderBrush="{Binding GpuTabBorder}" BorderThickness="1"
                                Style="{StaticResource BaseBtn}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🎮 GPU Fan Curve" FontSize="11" FontWeight="Bold" Foreground="{Binding GpuTabForeground}"/>
                                <TextBlock Text="{Binding GpuCurveLiveText, StringFormat=' ({0})'}" FontSize="10" Foreground="#78909C" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Profile Presets & Active Profile Badge -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Curve Profile:" FontSize="11" Foreground="#B0BEC5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ChipBtn}" Content="Silent" Click="CurveProfile_Click" Tag="Silent"
                                    Background="{Binding CurveSilentBtnBg}" BorderBrush="{Binding CurveSilentBtnBorder}" Foreground="{Binding CurveSilentBtnFg}"/>
                            <Button Style="{StaticResource ChipBtn}" Content="Balanced" Click="CurveProfile_Click" Tag="Balanced"
                                    Background="{Binding CurveBalancedBtnBg}" BorderBrush="{Binding CurveBalancedBtnBorder}" Foreground="{Binding CurveBalancedBtnFg}"/>
                            <Button Style="{StaticResource ChipBtn}" Content="Gaming" Click="CurveProfile_Click" Tag="Gaming"
                                    Background="{Binding CurveGamingBtnBg}" BorderBrush="{Binding CurveGamingBtnBorder}" Foreground="{Binding CurveGamingBtnFg}"/>
                            <TextBlock Text="{Binding CurrentCurvePreset, StringFormat='Active: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#78909C"
                                   Text="{Binding CurrentCurveTabTitle}"/>
                    </Grid>

                    <!-- Active Curve Points Grid -->
                    <ItemsControl ItemsSource="{Binding ActiveCurvePoints}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22252D" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Temperature, StringFormat='{}{0}°C'}" FontSize="11" FontWeight="Bold" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="➔" FontSize="9" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,1"/>
                                        <TextBlock Text="{Binding FanSpeed, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#E53935" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4b. All Sensors Panel (Collapsible) -->
            <Border Grid.Row="4" Background="#181A20" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                    BorderBrush="#303440" BorderThickness="1"
                    Visibility="{Binding IsSensorsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ALL TEMPERATURE &amp; HARDWARE SENSORS" FontSize="11" FontWeight="Bold" Foreground="#90A4AE" VerticalAlignment="Center"/>
                            <Border Background="#2B2E38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SensorCountText}" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="22" Height="22" Padding="0" Click="SensorsToggle_Click"/>
                    </Grid>

                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding AllSensors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20232B" CornerRadius="6" Padding="10,6" Margin="0,2,0,2"
                                            BorderBrush="#2B2F3A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Badge -->
                                            <Border Background="#2A2E3A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="#90A4AE"/>
                                            </Border>

                                            <!-- Name & Subtext -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                                <TextBlock Text="{Binding Subtext}" FontSize="9" Foreground="#607D8B" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Live Value with dynamic temp color -->
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedValue}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{Binding Value, Converter={StaticResource TempBrush}}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 5. Status Footer -->
            <Border Grid.Row="5" Background="#16181E" CornerRadius="6" Padding="12,6"
                    BorderBrush="#252731" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#00E676" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding BackendStatusText}" FontSize="10" Foreground="#90A4AE"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                               Foreground="#B0BEC5" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2" Text="DynoFanControl v2.0" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings Modal Overlay -->
        <Grid Background="#B0000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1C1E24" CornerRadius="12" Padding="20" Width="460" Height="490"
                    BorderBrush="#373B47" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Application Settings" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="26" Height="26" Padding="0" Click="SettingsToggle_Click"/>
                    </Grid>

                    <!-- Settings Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Startup -->
                            <CheckBox Content="Start with Windows (Task Scheduler, no UAC prompt)"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      Foreground="#ECEFF1" Margin="0,0,0,12"/>

                            <!-- Start Minimized -->
                            <CheckBox Content="Start Minimized to System Tray"
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                      Foreground="#ECEFF1" Margin="0,0,0,12"/>

                            <!-- Close to Tray -->
                            <CheckBox Content="Closing window minimizes to System Tray"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                      Foreground="#ECEFF1" Margin="0,0,0,16"/>

                            <Separator Background="#2A2D37" Margin="0,0,0,16"/>

                            <!-- Overheat Protection -->
                            <CheckBox Content="Enable Overheat Failsafe Protection"
                                      IsChecked="{Binding OverheatProtection, Mode=TwoWay}"
                                      Foreground="#ECEFF1" Margin="0,0,0,8"/>

                            <TextBlock Text="Force 100% fans when temperature exceeds threshold to prevent throttling:"
                                       FontSize="10" Foreground="#78909C" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="75" Maximum="95" Value="{Binding OverheatThreshold, Mode=TwoWay}"
                                        IsEnabled="{Binding OverheatProtection}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OverheatThreshold, StringFormat='{}{0}°C'}"
                                           FontSize="12" FontWeight="Bold" Foreground="#E53935"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <Separator Background="#2A2D37" Margin="0,0,0,14"/>

                            <!-- Multi-GPU Target Selector -->
                            <TextBlock Text="Target GPU for Smart Fan Curve:" FontSize="10" FontWeight="Bold" Foreground="#78909C" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DetectedGpus}" SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Background="#262933" Foreground="#ECEFF1" Height="28" FontSize="11" Margin="0,0,0,14"/>

                            <Separator Background="#2A2D37" Margin="0,0,0,14"/>

                            <!-- Hardware Platform & Active Driver -->
                            <TextBlock Text="Universal Hardware Diagnostics:" FontSize="10" FontWeight="Bold" Foreground="#78909C" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PlatformSummaryText, StringFormat='System: {0}'}" FontSize="10" Foreground="#B0BEC5" Margin="0,1"/>
                            <TextBlock Text="{Binding BackendStatusText, StringFormat='Fan Driver: {0}'}" FontSize="10" Foreground="#00E5FF" Margin="0,1"/>
                            <TextBlock Text="{Binding GpuName, StringFormat='Primary GPU: {0}'}" FontSize="10" Foreground="#B0BEC5" Margin="0,1"/>
                            <TextBlock Text="{Binding CpuModelName, StringFormat='CPU: {0}'}" FontSize="10" Foreground="#B0BEC5" Margin="0,1"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save / Close -->
                    <Button Grid.Row="2" Style="{StaticResource BaseBtn}" Height="32" Content="Done"
                            HorizontalAlignment="Right" Width="80" Click="SettingsToggle_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- GPU Tuning Modal Overlay (MSI Afterburner Overclocking & Undervolting Suite) -->
        <Grid Background="#B0000000" Visibility="{Binding IsTuningOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1C1E24" CornerRadius="12" Padding="20" Width="520" Height="560"
                    BorderBrush="#373B47" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ GPU Tuning &amp; Overclocking" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#2B2E38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AFTERBURNER SUITE" FontSize="9" FontWeight="Bold" Foreground="#FFD600"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="26" Height="26" Padding="0" Click="TuningToggle_Click"/>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,6,0">
                            <!-- GPU Live Status Banner -->
                            <Border Background="#20232B" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#2B2F3A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GpuName}" FontSize="12" FontWeight="Bold" Foreground="#ECEFF1"/>
                                        <TextBlock Text="{Binding GpuClocksLiveText}" FontSize="10" Foreground="#00E5FF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding GpuTempText}" FontSize="18" FontWeight="Bold"
                                               Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Presets Row -->
                            <TextBlock Text="TUNING PRESETS" FontSize="10" FontWeight="Bold" Foreground="#78909C" Margin="0,0,0,4"/>
                            <UniformGrid Columns="5" Margin="0,0,0,12">
                                <Button Style="{StaticResource BaseBtn}" Content="Stock" Margin="2,0" Height="26" FontSize="10" Click="TuningPreset_Click" Tag="Stock"/>
                                <Button Style="{StaticResource BaseBtn}" Content="Undervolt" Margin="2,0" Height="26" FontSize="10" Click="TuningPreset_Click" Tag="Undervolt"/>
                                <Button Style="{StaticResource BaseBtn}" Content="Balanced" Margin="2,0" Height="26" FontSize="10" Click="TuningPreset_Click" Tag="Balanced"/>
                                <Button Style="{StaticResource BaseBtn}" Content="Max OC" Margin="2,0" Height="26" FontSize="10" Click="TuningPreset_Click" Tag="MaxOC" Foreground="#FFD600"/>
                                <Button Style="{StaticResource BaseBtn}" Content="Eco" Margin="2,0" Height="26" FontSize="10" Click="TuningPreset_Click" Tag="Eco"/>
                            </UniformGrid>

                            <!-- Core Clock Offset Slider -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Core Clock Offset (MHz)" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding CoreClockOffsetText}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="-500" Maximum="1000" Value="{Binding CoreClockOffset, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <!-- Memory Clock Offset Slider -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Memory Clock Offset (MHz)" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding MemoryClockOffsetText}" FontSize="11" FontWeight="Bold" Foreground="#7C4DFF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="-500" Maximum="1500" Value="{Binding MemoryClockOffset, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <!-- Power Limit % Slider -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Power Limit (%)" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding PowerLimitPercentText}" FontSize="11" FontWeight="Bold" Foreground="#FF9100" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="50" Maximum="130" Value="{Binding PowerLimitPercent, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <!-- Temperature Limit °C Slider -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Temperature Limit Target (°C)" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding TempLimitCelsiusText}" FontSize="11" FontWeight="Bold" Foreground="#FF5252" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="65" Maximum="90" Value="{Binding TempLimitCelsius, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <!-- Voltage Offset mV Slider -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Core Voltage Offset (mV)" FontSize="11" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{Binding VoltageOffsetMvText}" FontSize="11" FontWeight="Bold" Foreground="#E040FB" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding VoltageOffsetMv, Mode=TwoWay}" Margin="0,0,0,12"/>

                            <Separator Background="#2A2D37" Margin="0,0,0,10"/>

                            <!-- User Profile Slots 1-5 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="PROFILE SLOTS" FontSize="10" FontWeight="Bold" Foreground="#78909C"/>
                                <TextBlock Text="Load: Click slot | Save: Click 💾 [N]" FontSize="9" Foreground="#546E7A" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource BaseBtn}" Content="Slot 1" Margin="2,0" Height="26" FontSize="10" Click="TuningSlot_Click" Tag="1"/>
                                <Button Grid.Column="1" Style="{StaticResource BaseBtn}" Content="Slot 2" Margin="2,0" Height="26" FontSize="10" Click="TuningSlot_Click" Tag="2"/>
                                <Button Grid.Column="2" Style="{StaticResource BaseBtn}" Content="Slot 3" Margin="2,0" Height="26" FontSize="10" Click="TuningSlot_Click" Tag="3"/>
                                <Button Grid.Column="3" Style="{StaticResource BaseBtn}" Content="Slot 4" Margin="2,0" Height="26" FontSize="10" Click="TuningSlot_Click" Tag="4"/>
                                <Button Grid.Column="4" Style="{StaticResource BaseBtn}" Content="Slot 5" Margin="2,0" Height="26" FontSize="10" Click="TuningSlot_Click" Tag="5"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Save to Slot:" FontSize="10" Foreground="#90A4AE" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource ChipBtn}" Content="💾 [1]" Click="TuningSaveSlot_Click" Tag="1"/>
                                <Button Style="{StaticResource ChipBtn}" Content="💾 [2]" Click="TuningSaveSlot_Click" Tag="2"/>
                                <Button Style="{StaticResource ChipBtn}" Content="💾 [3]" Click="TuningSaveSlot_Click" Tag="3"/>
                                <Button Style="{StaticResource ChipBtn}" Content="💾 [4]" Click="TuningSaveSlot_Click" Tag="4"/>
                                <Button Style="{StaticResource ChipBtn}" Content="💾 [5]" Click="TuningSaveSlot_Click" Tag="5"/>
                            </StackPanel>

                            <!-- Apply at Startup Checkbox -->
                            <CheckBox Content="Apply GPU Tuning Profile at Windows Startup"
                                      IsChecked="{Binding ApplyTuningAtStartup, Mode=TwoWay}"
                                      Foreground="#ECEFF1" Margin="0,0,0,8"/>

                            <!-- Tuning Status Feedback Text -->
                            <TextBlock Text="{Binding TuningStatusText}" FontSize="10" Foreground="#00E676" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <Grid Grid.Row="2">
                        <Button Style="{StaticResource BaseBtn}" Height="30" Content="Reset Stock"
                                HorizontalAlignment="Left" Width="95" Click="TuningReset_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BaseBtn}" Height="30" Content="Apply"
                                    Width="85" Margin="0,0,8,0" Background="#1A3B2F" BorderBrush="#00E676" Foreground="#00E676" FontWeight="Bold"
                                    Click="TuningApply_Click"/>
                            <Button Style="{StaticResource BaseBtn}" Height="30" Content="Done"
                                    Width="75" Click="TuningToggle_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Hardware Monitor & Graphs Modal Overlay (MSI Afterburner Hardware Monitor) -->
        <Grid Background="#B0000000" Visibility="{Binding IsMonitorOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1A1C22" CornerRadius="12" Padding="18" Width="550" Height="580"
                    BorderBrush="#373B47" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📉 Hardware Telemetry Graphs" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#2B2E38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="60s ROLLING HISTORY" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="26" Height="26" Padding="0" Click="MonitorToggle_Click"/>
                    </Grid>

                    <!-- Telemetry Graphs List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding TelemetrySeriesList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15171D" CornerRadius="8" Padding="10,8" Margin="0,0,6,8"
                                            BorderBrush="#252731" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="60"/>
                                            </Grid.RowDefinitions>

                                            <!-- Metric Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{Binding ColorHex}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedMin}" FontSize="9" Foreground="#607D8B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedMax}" FontSize="9" Foreground="#607D8B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Sparkline Canvas -->
                                            <Border Grid.Row="1" Background="#0F1014" CornerRadius="4" BorderBrush="#1F2128" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <Polygon Points="{Binding PolygonPoints}" Fill="{Binding ColorHex}" Opacity="0.15"/>
                                                    <Polyline Points="{Binding PolylinePoints}" Stroke="{Binding ColorHex}" StrokeThickness="1.5"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="Updated continuously every poll tick • Hardware acceleration" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BaseBtn}" Height="30" Content="Close"
                                HorizontalAlignment="Right" Width="80" Click="MonitorToggle_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- RivaTuner Statistics Server (RTSS) OSD Modal Overlay -->
        <Grid Background="#B0000000" Visibility="{Binding IsOsdOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1C1E24" CornerRadius="12" Padding="20" Width="510" Height="530"
                    BorderBrush="#373B47" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📺 RivaTuner (RTSS) In-Game OSD" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#2B2E38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DIRECTX / VULKAN" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BaseBtn}"
                                Width="26" Height="26" Padding="0" Click="OsdToggle_Click"/>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Master Toggle -->
                            <CheckBox Content="Enable In-Game On-Screen Display (OSD)"
                                      IsChecked="{Binding OsdEnabled, Mode=TwoWay}"
                                      FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>

                            <!-- RTSS Status Badge -->
                            <Border Background="#20232B" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" BorderBrush="#2B2F3A" BorderThickness="1">
                                <TextBlock Text="{Binding RtssStatusText}" FontSize="11" Foreground="#ECEFF1"/>
                            </Border>

                            <TextBlock Text="SELECT METRICS TO DISPLAY IN-GAME:" FontSize="10" FontWeight="Bold" Foreground="#78909C" Margin="0,0,0,6"/>

                            <!-- Metric Checkboxes Grid -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <CheckBox Content="GPU Temperature" IsChecked="{Binding OsdShowGpuTemp, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="GPU Core Load (%)" IsChecked="{Binding OsdShowGpuLoad, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="GPU Core &amp; Mem Clocks" IsChecked="{Binding OsdShowGpuClocks, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="GPU Power Draw (W)" IsChecked="{Binding OsdShowGpuPower, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="GPU VRAM Usage (MB)" IsChecked="{Binding OsdShowGpuVram, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="GPU Fan Speed (RPM)" IsChecked="{Binding OsdShowGpuFanRpm, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <CheckBox Content="CPU Temperature" IsChecked="{Binding OsdShowCpuTemp, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="CPU Package Load (%)" IsChecked="{Binding OsdShowCpuLoad, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="CPU Package Power (W)" IsChecked="{Binding OsdShowCpuPower, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="CPU Fan Speed (RPM)" IsChecked="{Binding OsdShowCpuFanRpm, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="System RAM Usage" IsChecked="{Binding OsdShowRamUsage, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                    <CheckBox Content="Active Fan Profile Badge" IsChecked="{Binding OsdShowActivePreset, Mode=TwoWay}" Foreground="#ECEFF1" Margin="0,3"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#2A2D37" Margin="0,0,0,10"/>

                            <!-- OSD Live Text Preview Box -->
                            <TextBlock Text="IN-GAME OVERLAY PREVIEW:" FontSize="10" FontWeight="Bold" Foreground="#78909C" Margin="0,0,0,6"/>
                            <Border Background="#0A0B0E" CornerRadius="6" Padding="12,10" BorderBrush="#1F2128" BorderThickness="1">
                                <TextBlock Text="{Binding OsdPreviewText}" FontFamily="Consolas, Lucida Console, monospace"
                                           FontSize="12" Foreground="#00E5FF" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Button Grid.Row="2" Style="{StaticResource BaseBtn}" Height="32" Content="Done"
                            HorizontalAlignment="Right" Width="80" Click="OsdToggle_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
